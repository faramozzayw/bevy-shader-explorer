<html lang="en">
  {{>head title="Bevy Shader Explorer" description=description canonical=canonicalURL ogImageURL=ogImageURL structuredData=structuredData}}
  <body>
    {{> header urlPrefix=urlPrefix version=version searchScope="packages" searchIndex=version }}
    <main>
      <section id="saved-shaders" class="saved-shaders" hidden>
        <div class="release-heading">
          <h2>Saved shaders</h2>
          <button type="button" class="saved-clear-button" data-saved-clear>Clear all</button>
        </div>
        <div class="saved-shader-list" data-saved-list></div>
      </section>
      
      <section class="release-list">
        <div class="release-heading">
          <h2>Packages</h2>
          {{#if issueURL}}<a class="request-crate" href="{{issueURL}}">Request a crate</a>{{/if}}
        </div>
        {{#each sections}}
          {{#each Groups}}
            <article class="release-row">
              <a class="release-row-content" href="/{{@root/urlPrefix}}{{#if @root/urlPrefix}}/{{/if}}{{DetailPath}}">
                <div class="release-main"><span class="release-name">{{PackageName}}</span></div>
                <p>{{Description}}</p>
                <div class="release-meta"><span>{{Count}} shaders</span><span>Browse package →</span></div>
              </a>
              {{> version-selector packageName=PackageName versionOptions=VersionOptions}}
            </article>
          {{/each}}
        {{/each}}
      </section>
    </main>
    {{> footer}}
  </body>
</html>

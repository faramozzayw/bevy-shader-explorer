<ul>
  {{#each this}}
    <li class="search-result-item">
      {{#if (eq kind "package")}}
        <img class="search-result-icon" src="/public/icons/repository.svg" alt="" aria-hidden="true" />
        <a class="function-name" href="{{link}}">{{name}}</a>
        <select class="version-select search-version-select" data-package="{{packageName}}" onchange="window.location.href='/' + this.value">
          {{#each versions}}
            <option value="{{url}}"{{#if @first}} selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
        {{#if description}}<span>{{description}}</span>{{/if}}
      {{else}}
      {{#if (eq type "function")}}<img class="search-result-icon" src="/public/icons/function.svg" alt="" aria-hidden="true" />{{/if}}
      {{#if (eq type "binding")}}<img class="search-result-icon" src="/public/icons/binding.svg" alt="" aria-hidden="true" />{{/if}}
      {{#if (eq type "struct")}}<img class="search-result-icon" src="/public/icons/struct.svg" alt="" aria-hidden="true" />{{/if}}
      {{#if (eq type "const")}}<img class="search-result-icon" src="/public/icons/constant.svg" alt="" aria-hidden="true" />{{/if}}
      <a class="function-name" href="{{link}}#{{name}}">{{name}}</a>
      {{#if multiVersion}}
        <select class="version-select search-version-select" onchange="window.location.href=this.value">
          {{#each versions}}
            <option value="{{url}}"{{#if @first}} selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      {{/if}}
      {{#if stageAttribute}}
        <span class="attribute-badge {{stageAttribute}}-badge">@{{stageAttribute}}</span>
      {{/if}}

      <span>(from <strong class="search-result-package">{{packageName}}</strong> · <i>{{filename}}</i>)</span>
      {{#if exportable}}
        <small>exportable</small>
      {{/if}}
      {{/if}}
    </li>
  {{/each}}
</ul>

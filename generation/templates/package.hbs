<html lang="en">
  {{>head title=name}}

  <body>
    {{> header urlPrefix=urlPrefix version=version searchScope="package" searchPackage=name searchVersion=packageVersion searchIndex=version }}

    <nav class="package-nav">
      <a href="/{{urlPrefix}}">Overview</a>
      <a class="active" href="/{{packageURLPrefix}}/index.html">Shaders</a>
    </nav>
    <div class="breadcrumbs"><a href="/{{urlPrefix}}">Packages</a> <span>›</span> <strong>{{name}}</strong> {{> version-selector packageName=name urlPrefix=packageURLPrefix projectVersion=packageVersion versionOptions=versionOptions}}</div>
    {{#if repository}}<div class="package-metadata"><a href="{{repository}}">Repository</a>{{#if license}}<span>License: {{license}}</span>{{/if}}{{#if homepage}}<a href="{{homepage}}">Homepage</a>{{/if}}</div>{{/if}}
    {{#if description}}<div class="package-description-block"><h2>Description</h2><p>{{description}}</p></div>{{/if}}
    {{#if hasDirectDependencies}}
      <section class="package-dependencies">
        <header><h2>Direct dependencies</h2><span class="shader-count">{{directDependencyCount}} packages</span></header>
        <div class="dependency-chips">
          {{#each directDependencies}}
            <a class="shader-chip dependency-chip" href="/{{url}}" title="{{name}} {{version}}">{{name}} <small>{{version}}</small></a>
          {{/each}}
        </div>
      </section>
    {{/if}}
    {{#if hasTransitiveDependencies}}
      <section class="package-dependencies">
        <header><h2>Transitive dependencies</h2><span class="shader-count">{{transitiveDependencyCount}} packages</span></header>
        <div class="dependency-chips">
          {{#each transitiveDependencies}}
            <a class="shader-chip dependency-chip" href="/{{url}}" title="{{name}} {{version}}">{{name}} <small>{{version}}</small></a>
          {{/each}}
        </div>
      </section>
    {{/if}}
    <section class="shader-section package-page">
      <header>
        <div>
          <h2>Shader modules</h2>
        </div>
        <span class="shader-count">{{count}} shaders</span>
      </header>
      <ul class="shader-list module-chip-list">
        {{#each files}}
          <li><a class="shader-chip module-chip" title="{{file}}" href="/{{@root/urlPrefix}}{{#if @root/urlPrefix}}/{{/if}}{{file}}">{{label}}</a></li>
        {{/each}}
      </ul>
    </section>
  </body>
</html>

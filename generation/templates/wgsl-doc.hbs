<html lang="en">
  {{>head title=seoTitle description=seoDescription canonical=canonicalURL ogImageURL=ogImageURL isShader=true structuredData=structuredData}}

  <body>
    {{> header urlPrefix=projectURLPrefix version=version searchScope="package" searchPackage=projectName searchVersion=projectVersion searchIndex=searchIndex }}

    <nav class="package-nav">
      <a href="/{{projectURLPrefix}}">Packages</a>
      <a class="active" href="/{{PackageURLPrefix}}/index.html">{{projectName}}</a>
    </nav>
    <div class="breadcrumbs"><a href="/{{projectURLPrefix}}">Packages</a> <span>›</span> <a href="/{{PackageURLPrefix}}/index.html">{{projectName}}</a> {{> version-selector packageName=projectName urlPrefix=PackageURLPrefix projectVersion=projectVersion versionOptions=versionOptions}} <span>›</span> <strong>{{filename}}</strong></div>

    <main class="shader-page{{#unless shaderDefs}} shader-page-no-controls{{/unless}}">
      {{#if shaderDefs}}
        <aside class="shader-def-controls">
          <label class="shader-def-toggle">
            <input id="interactive-shader-defs" type="checkbox" />
            <span>Enable interactive shader defs</span>
          </label>
          <div id="shader-def-options" class="shader-def-options" hidden>
            <h3>Shader definitions</h3>
            {{#each shaderDefs}}
              <label class="shader-def-option">
                <input type="checkbox" value="{{this}}" checked />
                <code>{{this}}</code>
              </label>
            {{/each}}
          </div>
        </aside>
      {{/if}}
      <div class="shader-page-content">
      <h1>
        <code>{{filename}}</code>
        {{#if githubLink}}<a href="{{githubLink}}" target="_blank" rel="noopener noreferrer">
          <picture>
            <source
              srcset="/public/github-mark-white.png"
              media="(prefers-color-scheme: dark)"
            />
            <img src="/public/github-mark.png" width="20" height="20" />
          </picture>
        </a>{{/if}}
      </h1>

      {{#if importPath}}
        <div class="import-path">
          <h3>Import path</h3>
          <button class="import-path-button" onclick="navigator.clipboard.writeText('{{importPath}}')">
            {{importPath}}
            <small>(click to copy)</small>
          </button>
        </div>
      {{/if}}

      {{#if notEmptyConsts}}
        <h3 id="constants" class="section-header">Constants</h3>

        {{#each (group-by-name consts)}}
          <section id="{{name}}">
            <header>
              <div>
                <h3 class="function-name">
                  {{name}}
                </h3>
                <a href="#{{name}}">#</a>
                {{#with first}}{{> gh-link }}{{/with}}
              </div>

              {{#if ../importPath}}
                <div>
                  <button class="import-path-button" onclick="navigator.clipboard.writeText('#import {{../importPath}}::{{name}}')">
                    Copy import statement
                  </button>
                </div>
              {{/if}}
            </header>

            {{#each items}}
            <div class="declaration-variant" data-shader-defs='{{{json shaderDefs}}}'>
            {{#if hasShaderDefs}}
              <div class="function-shader-defs">
                <span class="shader-def-label">Active when</span>
                <div class="shader-def-pills">{{> shader-defs-list }}</div>
              </div>
            {{/if}}

            <div class="signature code-background">
              <span class="keyword">const</span>
              <span>{{name}}:</span>
              {{> type }}
              <span>=</span>
              <span class="value">{{value}}</span>
            </div>
            </div>
            {{/each}}
          </section>
        {{/each}}
      {{/if}}

      {{#if notEmptyBindings}}
        <h3 id="bindings" class="section-header">Bindings</h3>

        {{#each (group-by-name bindings)}}
          <section id="{{name}}">
            <header>
              <div>
                <h3 class="function-name">
                  {{name}}
                </h3>
                <a href="#{{name}}">#</a>
                {{#with first}}{{> gh-link }}{{/with}}
              </div>

              {{#if ../importPath}}
                <div>
                  <button class="import-path-button" onclick="navigator.clipboard.writeText('#import {{../importPath}}::{{name}}')">
                    Copy import statement
                  </button>
                </div>
              {{/if}}
            </header>

          {{#each items}}
          <div class="declaration-variant" data-shader-defs='{{{json shaderDefs}}}'>
          {{#if hasShaderDefs}}
            <div class="function-shader-defs">
              <span class="shader-def-label">Active when</span>
              <div class="shader-def-pills">{{> shader-defs-list }}</div>
            </div>
          {{/if}}

            <div class="signature code-background">
              {{> annotations }}
              <span><span class="keyword">var</span>{{#if bindingType}}&lt;<span class="keyword">{{bindingType}}</span>&gt;{{/if}}</span>
              <span>{{name}}:</span>
              {{> type }}
            </div>
          </div>
          {{/each}}
          </section>
        {{/each}}
      {{/if}}

      {{#if notEmptyStructures}}
        <h3 id="structures" class="section-header">Structures</h3>

        {{#each (group-by-name structures)}}
          <section id="{{name}}">
            <header>
              <div>
                <h3 class="function-name">
                  {{name}}
                </h3>
                <a href="#{{name}}">#</a>
                {{#with first}}{{> gh-link }}{{/with}}
              </div>

              {{#if ../importPath}}
                <div>
                  <button class="import-path-button" onclick="navigator.clipboard.writeText('#import {{../importPath}}::{{name}}')">
                    Copy import statement
                  </button>
                </div>
              {{/if}}
            </header>

            {{#each items}}
            <div class="declaration-variant" data-shader-defs='{{{json shaderDefs}}}'>
            {{#if comment}}
              <div class="function-comment">{{{parse-markdown comment}}}</div>
            {{/if}}

            <div class="code-background">
              <span class="keyword">struct</span>
              <span class="item-name">{{name}}</span>
              <span>{</span>

              <div class="struct-field-rows">
                {{#each fields}}
                    <div class="struct-field-row" data-shader-defs='{{{json shaderDefs}}}'>
                    {{> annotations }}
                    <span>{{name}}:</span>
                    {{> type}}
                    <span>,</span>
                    {{#if hasShaderDefs}}
                      <span>{{> shader-defs-list }}</span>
                    {{/if}}
                    </div>
                {{/each}}
              </div>

              <span>}</span>
            </div>
            </div>
            {{/each}}
          </section>
        {{/each}}
      {{/if}}

      {{#if notEmptyFunctions}}
        <h3 id="functions" class="section-header">Functions</h3>
      
        {{#each (group-by-name functions)}}
          <section id="{{name}}">
            <header>
              <div>
                <h3 class="function-name">{{name}}</h3>
                <a href="#{{name}}">#</a>
                {{#with first}}{{> gh-link }}{{/with}}
              </div>

              {{#with first}}
                {{#if stageAttribute}}
                  <div class="function-attributes">
                    <div class="tooltip-container">
                      <span class="attribute-badge {{stageAttribute}}-badge">@{{stageAttribute}}</span>
                      <div class="tooltip-text">
                        {{#if (eq stageAttribute "vertex")}}Processes each 3D point in a model before it's drawn{{/if}}
                        {{#if (eq stageAttribute "fragment")}}Calculates the final color of each pixel on the screen{{/if}}
                        {{#if (eq stageAttribute "compute")}}Runs custom parallel code on the GPU, not limited to graphics{{/if}}
                      </div>
                    </div>
                    {{#if hasWorkgroupSize}}
                      <div class="tooltip-container">
                        <span class="attribute-badge workgroup-size-badge">@workgroup_size({{#each workgroupSize}}{{this}}{{#unless @last}},&nbsp;{{/unless}}{{/each}})</span>
                        <div class="tooltip-text">Defines the size of a thread group. One to three numbers: width (x), height (y), and depth (z). Missing values default to 1</div>
                      </div>
                    {{/if}}
                  </div>
                {{/if}}
              {{/with}}

              {{#with first}}
                {{#unless stageAttribute}}
                  {{#if importPath}}
                    <div>
                      <button class="import-path-button" onclick="navigator.clipboard.writeText('#import {{importPath}}::{{../name}}')">
                        Copy import statement
                      </button>
                    </div>
                  {{/if}}
                {{/unless}}
              {{/with}}
            </header>

            {{#each items}}
            <div class="declaration-variant" data-shader-defs='{{{json shaderDefs}}}'>
            {{#if hasShaderDefs}}
              <div class="function-shader-defs">
                <span class="shader-def-label">Active when</span>
                <div class="shader-def-pills">{{> shader-defs-list }}</div>
              </div>
            {{/if}}

            {{#if comment}}
              <div class="function-comment">{{{parse-markdown comment}}}</div>
            {{/if}}

            <div class="signature code-background">
              <span class="keyword">fn</span>
              <span class="item-name no-margin">{{name}}</span>
              ({{#each params}}
                  <div class="param {{#if @last}}no-margin{{/if}}">{{> annotations }}<span>{{name}}: </span>{{> type}}</div>{{#unless @last}},&nbsp;{{/unless}}
                {{/each}})

              {{#if (neq returnTypeInfo.type "void")}}
                <span class="arrow">-></span>
                {{> annotations annotations=returnTypeInfo.annotations}}
                {{> type typeInfo=returnTypeInfo }}
              {{/if}}
            </div>
            </div>
            {{/each}}
          </section>
        {{/each}}
      {{/if}}
      </div>
      <details class="shader-toc" open>
        <summary>Contents</summary>
        <nav>
          <ul>
            {{#if notEmptyConsts}}
              <li>
                <a href="#constants">Constants</a>
                <ul>
                  {{#each (group-by-name consts)}}<li><a href="#{{name}}">{{name}}</a></li>{{/each}}
                </ul>
              </li>
            {{/if}}
            {{#if notEmptyBindings}}
              <li>
                <a href="#bindings">Bindings</a>
                <ul>
                  {{#each (group-by-name bindings)}}<li><a href="#{{name}}">{{name}}</a></li>{{/each}}
                </ul>
              </li>
            {{/if}}
            {{#if notEmptyStructures}}
              <li>
                <a href="#structures">Structures</a>
                <ul>
                  {{#each (group-by-name structures)}}<li><a href="#{{name}}">{{name}}</a></li>{{/each}}
                </ul>
              </li>
            {{/if}}
            {{#if notEmptyFunctions}}
              <li>
                <a href="#functions">Functions</a>
                <ul>
                  {{#each (group-by-name functions)}}<li><a href="#{{name}}">{{name}}</a></li>{{/each}}
                </ul>
              </li>
            {{/if}}
          </ul>
        </nav>
      </details>
    </main>
    {{> footer}}
  </body>
</html>

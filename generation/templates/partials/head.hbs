<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="application-name" content="Bevy Shader Explorer" />
  <meta name="theme-color" content="#c9c4a8" />
  <title>{{title}}</title>
  {{#if description}}<meta name="description" content="{{description}}" />{{/if}}
  {{#if canonical}}<link rel="canonical" href="{{canonical}}" />{{/if}}
  <meta property="og:title" content="{{title}}" />
  {{#if description}}<meta property="og:description" content="{{description}}" />{{/if}}
  {{#if canonical}}<meta property="og:url" content="{{canonical}}" />{{/if}}
  <meta property="og:type" content="{{#if isShader}}article{{else}}website{{/if}}" />
  <meta property="og:site_name" content="Bevy Shader Explorer" />
  <meta property="og:locale" content="en_US" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{title}}" />
  {{#if description}}<meta name="twitter:description" content="{{description}}" />{{/if}}
  {{#if ogImageURL}}
    <meta property="og:image" content="{{ogImageURL}}" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:image" content="{{ogImageURL}}" />
  {{/if}}
  {{#if structuredData}}<script type="application/ld+json">{{{structuredData}}}</script>{{/if}}

  <link href="https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@300;500;700&amp;family=Share+Tech+Mono&amp;display=swap" rel="stylesheet" data-dc-tpl="2">
  <link rel="stylesheet" href="/public/styles.css" />
  <link
    href="https://fonts.googleapis.com/css2?family=Fira+Code&display=swap"
    rel="stylesheet"
  />
  <link rel="icon" href="/public/favicon.ico" sizes="any" />
  <link rel="icon" href="/public/icon.png" type="image/png" />

  <script src="https://cdn.jsdelivr.net/gh/nextapps-de/flexsearch@0.8.2/dist/flexsearch.bundle.min.js"></script>
  <script
    src="https://cdn.jsdelivr.net/npm/handlebars@latest/dist/handlebars.min.js"
  ></script>
  <script src="/public/search.js" type="text/javascript"></script>
  <script defer src="/public/select.js" type="text/javascript"></script>
  <script defer src="/public/saved.js" type="text/javascript"></script>
  {{#if isShader}}<script defer src="/public/shader-defs.js" type="text/javascript"></script>{{/if}}
  <script defer src="/_vercel/insights/script.js"></script>
</head>

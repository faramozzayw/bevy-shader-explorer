{{#if typeInfo.typeParts}}
  {{#each typeInfo.typeParts}}{{#if typeLink}}<a href="{{typeLink}}" target="{{#if (contains "w3.org" typeLink)}}_blank{{else if typeLinkBlank}}_blank{{else}}_self{{/if}}" rel="noopener noreferrer" class="item-name img-link">{{text}}</a>{{else}}{{text}}{{/if}}{{/each}}
{{else if typeInfo.typeLink}}
  <a
    href="{{typeInfo.typeLink}}"
    target="{{#if (contains "w3.org" typeInfo.typeLink)}}_blank{{else if typeInfo.typeLinkBlank}}_blank{{else}}_self{{/if}}"
    rel="noopener noreferrer"
    class="item-name img-link"
  >
    {{typeInfo.type}}
  </a>
{{else}}
  <span class="item-name">{{typeInfo.type}}</span>
{{/if}}

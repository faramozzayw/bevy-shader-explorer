<header data-search-scope="{{searchScope}}" data-search-package="{{searchPackage}}" data-search-version="{{searchVersion}}" data-search-index="{{searchIndex}}">
  <div class="header-container">
    <a class="site-brand" href="/{{urlPrefix}}">Shader Explorer</a>
    <button
      id="menu-toggle"
      class="menu-toggle"
      aria-label="Toggle menu"
    >☰</button>
    <nav id="nav-links" class="nav-links">
      <a
        href="https://www.w3.org/TR/WGSL"
        target="_blank"
        rel="noopener noreferrer"
        class="header-link"
      >
        WGSL Spec
        <img src="/public/wgsl.png" width="20" height="20" />
      </a>
      <a
        href="https://github.com/bevyengine/bevy"
        target="_blank"
        rel="noopener noreferrer"
        class="header-link"
      >
        Bevy
        <picture>
          <source
            srcset="/public/github-mark-white.png"
            media="(prefers-color-scheme: dark)"
          />
          <img src="/public/github-mark.png" width="20" height="20" />
        </picture>
      </a>
      <a
        href="https://webgpufundamentals.org/webgpu/lessons/webgpu-wgsl-function-reference.html"
        target="_blank"
        rel="noopener noreferrer"
        class="header-link"
      >
        WGSL Functions
      </a>
    </nav>
    <div class="search-input-wrapper">
      <input
        type="text"
        id="search-input"
        class="search-input"
        placeholder="Type ‘S’ or ‘/’ to search 🔍"
      />
      <span class="search-shortcut" aria-hidden="true">S /</span>
    </div>
    <details class="header-help">
      <summary>Syntax <span aria-hidden="true">+</span></summary>
      <div class="header-help-body">
        <span><code>space</code> all</span><span><code>|</code> any</span><span><code>=term</code> exact</span><span><code>!term</code> exclude</span><span><code>^term</code> prefix</span><span><code>.ext$</code> suffix</span>
      </div>
    </details>
  </div>
  <div id="results"></div>
</header>
<script>
  const toggle = document.getElementById('menu-toggle'); const nav =
  document.getElementById('nav-links'); toggle.addEventListener('click', () => {
  nav.classList.toggle('show'); });
</script>

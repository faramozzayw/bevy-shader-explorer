<html lang="en">
  {{>head title=seoTitle description=seoDescription canonical=canonicalURL ogImageURL=ogImageURL isShader=true structuredData=structuredData}}

  <body>
    {{> header urlPrefix=projectURLPrefix version=version searchScope="package" searchPackage=projectName searchVersion=projectVersion searchIndex=searchIndex }}

    <main class="shader-page{{#unless shaderDefs}} shader-page-no-controls{{/unless}} source-page">
      {{#if shaderDefs}}
      <aside class="shader-def-controls">
        <label class="shader-def-toggle" for="interactive-shader-defs">
          <input id="interactive-shader-defs" type="checkbox" />
          <span>Toggle shader defs</span>
        </label>
        <div id="shader-def-options" class="shader-def-options" hidden>
          {{#each shaderDefs}}
          <label class="shader-def-option"><input type="checkbox" value="{{this}}" checked /><code>{{this}}</code></label>
          {{/each}}
        </div>
      </aside>
      {{/if}}
      <div class="shader-main-column">
      <header class="shader-page-header">
        <div class="breadcrumbs">
          <a href="/{{projectURLPrefix}}">Packages</a>
          <span>›</span>
          <a href="/{{PackageURLPrefix}}/index.html">{{projectName}}</a>
          {{> version-selector packageName=projectName urlPrefix=PackageURLPrefix projectVersion=projectVersion versionOptions=versionOptions}}
          <span>›</span>
          <a href="{{backLink}}">{{filename}}</a>
          <span>›</span>
          <strong>source</strong>

          {{#if githubLink}}<a href="{{githubLink}}" target="_blank" rel="noopener noreferrer">
              <picture>
                <img src="/public/icons/github.svg" width="20" height="20" alt="" />
              </picture>
            </a>{{/if}}
        </div>
      </header>
      <div class="shader-page-content">
        <div class="source-view" data-line-count="{{lineCount}}">
          <div class="source-back-anchor">
            <a class="site-button site-button-secondary source-back-button" href="{{backLink}}">← Back to declarations</a>
          </div>
          <pre class="source-code"><code>{{#each lines}}<div class="source-line" id="L{{number}}" data-shader-defs='{{{json shaderDefs}}}'><a class="source-line-number" href="#L{{number}}" tabindex="-1" aria-label="Line {{number}}">{{number}}</a><span class="source-line-text">{{{html}}}</span></div>{{/each}}</code></pre>
        </div>
      </div>
      </div>
      {{#if TOCSections}}
      <details class="shader-toc source-toc" open>
        <summary>Contents</summary>
        <nav>
          <ul>
            {{#each TOCSections}}
              <li>
                <a href="#L{{Items.[0].Line}}"><img class="toc-icon" src="/public/icons/{{Icon}}" alt="" aria-hidden="true" />{{Name}}</a>
                <ul>
                  {{#each Items}}<li><a href="#L{{Line}}">{{Name}}</a></li>{{/each}}
                </ul>
              </li>
            {{/each}}
          </ul>
        </nav>
      </details>
      {{/if}}
    </main>
    {{> footer}}
  </body>
</html>

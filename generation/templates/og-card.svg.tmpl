<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="630" viewBox="0 0 1200 630">
  <defs>
    <linearGradient id="paper" x1="0" y1="0" x2="1" y2="0">
      <stop stop-color="#f0ecd9" stop-opacity=".92"/>
      <stop offset=".68" stop-color="#f0ecd9" stop-opacity=".72"/>
      <stop offset="1" stop-color="#f0ecd9" stop-opacity="0"/>
    </linearGradient>
  </defs>
  <image href="../mascot.png" x="0" y="0" width="1200" height="630" preserveAspectRatio="xMidYMid slice"/>
  <rect x="24" y="24" width="720" height="582" rx="4" fill="url(#paper)"/>
  <text x="58" y="92" fill="#30302b" font-family="monospace" font-size="25" font-weight="bold" letter-spacing="2">BEVY SHADER EXPLORER</text>
  <text x="58" y="232" fill="#292a26" font-family="monospace" font-size="56" font-weight="bold">{{.Title}}</text>
  <text x="60" y="292" fill="#55544b" font-family="monospace" font-size="26">{{.VersionLine}}</text>
  <text x="60" y="400" fill="#3b3a34" font-family="sans-serif" font-size="25">{{range .DescriptionLines}}<tspan x="60" dy="{{.DeltaY}}">{{.Text}}</tspan>{{end}}</text>
</svg>

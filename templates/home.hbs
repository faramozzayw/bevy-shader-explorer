<html lang="en">
  {{>head title="Shader Explorer"}}
  <body class="catalogue-page">
    {{> header urlPrefix=urlPrefix version=version skipHomeButton=true searchScope="packages" searchIndex=version }}
    <main class="catalogue-main">
      
      <section class="release-list">
        <h2>Packages</h2>
        {{#each sections}}
          {{#each Groups}}
            <article class="release-row">
              <a class="release-row-content" href="/{{@root/urlPrefix}}{{#if @root/urlPrefix}}/{{/if}}{{DetailPath}}">
                <div class="release-main"><span class="release-name">{{PackageName}}</span></div>
                <p>{{Description}}</p>
                <div class="release-meta"><span>{{Count}} shaders</span><span>Browse package →</span></div>
              </a>
              {{> version-selector packageName=PackageName versionOptions=VersionOptions}}
            </article>
          {{/each}}
        {{/each}}
      </section>
    </main>
  </body>
</html>

<html lang="en">
  {{>head title=name}}
  <body class="catalogue-page">
    {{> header urlPrefix=urlPrefix version=version skipHomeButton=true }}
    <main class="catalogue-main">
      
      <section class="release-list">
        <h2>Packages</h2>
        {{#each sections}}
          {{#each Groups}}
            <article class="release-row">
              <div class="release-main"><a class="release-name" href="/{{@root/urlPrefix}}{{#if @root/urlPrefix}}/{{/if}}{{DetailPath}}">{{PackageName}}</a><span class="release-version">{{Version}}</span></div>
              <p>{{Description}}</p>
              <div class="release-meta"><span>{{Count}} shaders</span><a href="/{{@root/urlPrefix}}{{#if @root/urlPrefix}}/{{/if}}{{DetailPath}}">Browse package →</a></div>
            </article>
          {{/each}}
        {{/each}}
      </section>
    </main>
  </body>
</html>
